# Copy this file to .env.local for local development.
# In production, set these as environment variables in your hosting
# platform's dashboard (e.g. Vercel Project Settings -> Environment Variables).
# NEVER commit a real .env.local to source control.

# Anthropic API key — powers the four-layer research engine.
# Get this from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace-me

# Brave Search API key — powers live web search in the bosonic layer.
# Get this from api.search.brave.com
BRAVE_API_KEY=replace-me

# Database connection string — Postgres (Vercel Postgres, Supabase, or similar)
DATABASE_URL=postgres://user:password@host:5432/searchllm

# Clerk — authentication
# Get these from dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_replace_me
CLERK_SECRET_KEY=sk_replace_me

# Razorpay — payments for the Plus plan (Stripe is invite-only for new
# Indian businesses, so Razorpay is the payment provider here).
# Key ID + Secret: dashboard.razorpay.com -> Settings -> API Keys.
# Plan ID: create a YEARLY Plan (₹499 — must match PLANS.plus in
# lib/constants.js exactly) under Subscriptions -> Plans, then copy its
# plan_xxx ID. Yearly is deliberate — the business runs on affiliate
# revenue, Plus is priced low-friction/annual, not a monthly line item.
# Webhook secret: Settings -> Webhooks -> add
#   https://searchllm.shop/api/razorpay/webhook
# with events subscription.activated, subscription.charged,
# subscription.cancelled, subscription.halted, subscription.completed,
# subscription.paused, payment_link.paid (the last one is the ₹249
# "Increase Usage" recharge, not a subscription event — easy to forget) —
# the secret you set there goes below.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_PLAN_ID=plan_replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Comma-separated list of admin email addresses.
# Anyone signing in with one of these emails sees the review queue.
# Server-side enforcement (the one that actually matters) lives in
# app/api/admin/listings/route.js and reads ADMIN_EMAILS.
ADMIN_EMAILS=you@searchllm.shop

# Same list, exposed to the client ONLY to decide whether to show the
# "Review queue" tab in the UI. This is a convenience, not a security
# boundary — the real check is server-side above. Keep these two in sync.
NEXT_PUBLIC_ADMIN_EMAILS=you@searchllm.shop

# --- Automatic product feed sync (lib/feeds/) ---
# These are separate from the publisher API keys used for click tracking
# — they're specifically for pulling product/catalog data. Get them from
# each network's own dashboard once you're an approved publisher.

# Awin: Toolbox -> Create-a-Feed in the Awin platform gives you this key.
# Different from your main Awin publisher API key.
AWIN_DATAFEED_API_KEY=replace-me

# Impact: found in your Impact account settings under API credentials.
# AccountSID and AuthToken are used together for Basic auth on every
# catalog/items request.
IMPACT_ACCOUNT_SID=replace-me
IMPACT_AUTH_TOKEN=replace-me

# vCommission (runs on the Trackier platform). Get your Publisher API key
# from the vCommission/Trackier publisher dashboard. The adapter calls
# https://api.trackier.com/v2/publisher/campaigns?apiKey=...&showApproved=1
# NETWORK_ID is not required for Trackier's campaigns endpoint, but is kept
# for the credential-guard; set it to any non-empty value (e.g. your pub id)
# to enable the vCommission sync.
VCOMMISSION_API_KEY=replace-me

# Secret Vercel Cron uses to authenticate scheduled sync runs. Generate
# with `openssl rand -hex 32`. Vercel automatically sends this as
# "Authorization: Bearer <value>" on cron-triggered requests — see
# app/api/admin/sync/route.js.
CRON_SECRET=replace-me

# vCommission network/publisher ID — shown alongside your API key in the
# dashboard. Both are required for the product feed sync.
VCOMMISSION_NETWORK_ID=replace-me
# Optional: override if your account manager gives you a different base URL.
# VCOMMISSION_API_BASE=https://api.vcommission.com/v1

# Impact.com site-ownership verification token. In the Impact dashboard:
# Settings -> Media Properties -> your website -> Verify -> Meta Tag
# method. Copy ONLY the token value from inside the tag they show you
# (not the whole <meta ...> tag) and paste it here. Rendered into <head>
# by app/layout.jsx. Remove after verification if you like — harmless to keep.
NEXT_PUBLIC_IMPACT_SITE_VERIFICATION=replace-me

# vCommission PRODUCT feeds (hosted CSV files, not part of the Publisher API).
# Ask your vCommission account manager for the feed URL(s) — comma-separate
# multiple files. Each sync run pulls one file, advancing by cursor.
VCOMMISSION_PRODUCT_FEED_URLS=
# Optional price floor, in rupees. Default 0 — include everything.
# A cheap product that does its job is a legitimate recommendation, so price
# is a poor filter for quality; the model judges fitness for purpose instead.
# Only raise this if the review queue is genuinely unusable.
MIN_PRODUCT_PRICE=0

# --- Gift-voucher auto-issuance (lib/vouchers/qwikcilver.js) ---
# Real integration against Pine Labs' QwikGiftAPI (developers.woohoo.in),
# OAuth2 + request signing included. Two things still need filling in
# once you have a real account — see the comment block at the top of that
# file: (1) the values below, from Pine Labs' onboarding team; (2) the
# BRAND_SKU_MAP in that file, looked up via /api/admin/qwikcilverdiag
# once (1) is set. Leave these unset and the admin Rewards queue just
# shows the existing manual "Fulfil" flow (paste a voucher code by hand).
QWIKCILVER_CLIENT_ID=replace-me
QWIKCILVER_CLIENT_SECRET=replace-me
QWIKCILVER_USERNAME=replace-me
QWIKCILVER_PASSWORD=replace-me
# Defaults already point at the sandbox — override only if Pine Labs gives
# you different hosts (e.g. once moving to production).
# QWIKCILVER_OAUTH_BASE=https://sandbox.woohoo.in
# QWIKCILVER_API_BASE=https://sandbox.woohoo.in/rest

# The Order API requires a billing party on every order regardless of
# delivery mode. Since deliveryMode is set to "API" (the voucher code
# comes back in the response, Qwikcilver never emails/texts anyone), this
# is OUR business's own contact info, not the redeeming member's.
QWIKCILVER_BILLING_NAME=replace-me
QWIKCILVER_BILLING_EMAIL=replace-me
QWIKCILVER_BILLING_PHONE=replace-me
QWIKCILVER_BILLING_LINE1=replace-me
QWIKCILVER_BILLING_CITY=replace-me
QWIKCILVER_BILLING_REGION=replace-me
QWIKCILVER_BILLING_POSTCODE=replace-me
# QWIKCILVER_BILLING_COUNTRY=IN

# Static outbound IP for Pine Labs' allowlisting (B2B financial APIs
# typically require it — confirm with the account manager). Get this from
# QuotaGuard Static (https://www.quotaguard.com/) — sign up, copy the
# QUOTAGUARDSTATIC_URL connection string from their dashboard, and give
# their two static IPs (shown in the same dashboard) to Pine Labs to
# allowlist. Format: http://user:pass@static-x.quotaguard.com:9293
# Leave unset locally — outbound calls just go out direct, fine for a
# sandbox that doesn't enforce allowlisting.
QUOTAGUARDSTATIC_URL=
